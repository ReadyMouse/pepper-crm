# Pepper CRM Environment Template
#
#   Example configuration for local development. Copy to `.env` and fill in values.
#
# INPUT: Developer copies this file to `.env` and sets secrets/paths.
# OUTPUT: Runtime env vars consumed by pepper, pepper-web, and MCP servers via dotenvy.
# NOTES: DATABASE_URL uses macOS username (no password). Optional vars are commented out.
#
# Written by Cursor for Ready Mouse and Pepper CRM. May 2026. All rights reserved.

# Database (optional — Pepper no longer requires PostgreSQL; VCF is the source of truth)
# DATABASE_URL=postgresql://YOUR_USERNAME@localhost/pepper_crm

# SMTP Email Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mylo.mbennett@gmail.com
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM=mylo.mbennett@gmail.com

# Email Digest
DIGEST_RECIPIENT=your-email@example.com
# Link in weekly digest email → pepper-web dashboard (set to your public URL when deployed)
PEPPER_DASHBOARD_URL=http://127.0.0.1:3000

# Contacts & cache
CONTACTS_DIR=./contacts
CACHE_DIR=.cache

# Google Calendar — secret iCal URL (event SUMMARY = destination)
GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/basic.ics

# Geocoding (Nominatim / OpenStreetMap)
GEOCODER=nominatim
NOMINATIM_USER_AGENT=pepper-crm/1.0 (you@example.com)
# Optional CLI override (web dashboard defaults to 30 mi)
# METRO_RADIUS_MI=30
# METRO_RADIUS_KM=48.28
GEOCODE_CACHE_TTL_DAYS=7
# Write GEO + X-PEPPER-GEO-SOURCE back to vCard files when geocoding (default on)
GEO_WRITE_TO_VCF=true

# Optional: override target week for dev (ISO week id, e.g. 2026-W21)
# TRAVEL_WEEK_OVERRIDE=2026-W21

# CardDAV — when set, Pepper reads/writes contacts via Radicale instead of CONTACTS_DIR
# Collection URL (trailing slash optional), e.g. Radicale address book:
# CARDDAV_URL=https://your-pi.tailnet:5232/alice/contacts/
# CARDDAV_USER=alice
# CARDDAV_PASS=your-password
# CARDDAV_INSECURE=true   # optional: accept self-signed TLS (homelab)
